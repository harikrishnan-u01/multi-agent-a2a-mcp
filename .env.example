# Copy this file to .env and fill in your values.
# The system works fully without an Anthropic key — it uses Ollama locally.

# Optional: Anthropic API key (not used by default; extend orchestrator to use Claude instead of Ollama)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama settings (defaults match Ollama's standard local install)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Port overrides (optional — defaults from config/settings.yaml are used if not set)
# MCP_PORT=8000
# WELLNESS_API_PORT=8001
# LEARNING_API_PORT=8002
